QMainWindow {
    background-color: #2b2b2b;
}

QMainWindow::separator {
    background-color: #202020;
    width: 6px;
    height: 6px;
}

QMainWindow::separator:hover {
    background-color: #6685a3;
}

QDockWidget {
    color: #e8e8e8;
}

QDockWidget::title {
    background-color: #292929;
    padding: 7px;
}

QWidget#editorPanel {
    background-color: #303030;
}

QLineEdit {
    color: #eeeeee;
}

QLineEdit {
    background-color: #222222;
    border: 1px solid #555555;
    padding: 5px;
}

QMenuBar {
    background-color: #222222;
    color: #e8e8e8;
}

QMenuBar::item {
    padding: 6px 12px;
}

QMenuBar::item:selected {
    background-color: #8f001a;
}

QMenu {
    background-color: #2b2b2b;
    color: #eeeeee;
}

QMenu::item:selected {
    background-color: #8f001a;
}

QDialog {
    background-color: #2b2b2b;
    color: white;
}

QLabel {
    color: white;
}

QListWidget {
    background-color: #222222;
    color: white;
    border: 1px solid #555555;
}

QListWidget::item {
    padding: 7px;
}

QListWidget::item:selected {
    background-color: #4a4a4a;
}

QPushButton {
    background-color: #3a3a3a;
    color: white;
    border: 1px solid #666666;
    padding: 7px;
    border-radius: 3px;
}

QPushButton:hover {
    background-color: #505050;
}

QDialog QDoubleSpinBox {
    background-color: #222222;
    color: white;
    border: 1px solid #666666;
    padding: 5px;
}

/* Structural panels reuse the editor palette for standard Qt tree/tab widgets. */
QTreeWidget#analysisHierarchy {
    background: #292929; color: #dddddd; border: none; outline: none;
}
QTreeWidget#analysisHierarchy::item { padding: 3px; }
QTreeWidget#analysisHierarchy::item:hover { background: #393035; }
QTreeWidget#analysisHierarchy::item:selected { background: #52343d; color: #ffffff; }
QTabWidget#analysisResults::pane { background: #292929; border: 1px solid #444444; }
QTabWidget#analysisResults QTabBar::tab {
    background: #343434; color: #cccccc; padding: 6px 12px;
    border: 1px solid #444444;
}
QTabWidget#analysisResults QTabBar::tab:selected { background: #292929; border-bottom: 2px solid #d64565; }
QLabel#analysisReport { background: #292929; color: #dddddd; padding: 12px; }
QStatusBar#analysisStatus { background: #222222; color: #dddddd; }
QStatusBar#analysisStatus QProgressBar {
    border: 1px solid #444444; background: #292929; color: #dddddd; text-align: center;
}
QStatusBar#analysisStatus QProgressBar::chunk { background: #8f001a; }

QMainWindow#structuralWindow QCheckBox { color: #cccccc; background: transparent; }
QMainWindow#structuralWindow QCheckBox::indicator {
    width: 13px; height: 13px; background: #1f1f1f; border: 1px solid #666666; border-radius: 2px;
}
QMainWindow#structuralWindow QCheckBox::indicator:checked { background: #8f001a; border-color: #d64565; }
