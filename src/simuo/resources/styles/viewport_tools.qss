QFrame#viewportToolRail {
    background: #252a31;
    border: 1px solid #414853;
    border-radius: 5px;
}
QFrame#viewportToolRail QToolButton {
    color: #d5dde7;
    background: transparent;
    border: 1px solid transparent;
    border-radius: 3px;
    padding: 6px;
    text-align: left;
}
QFrame#viewportToolRail QToolButton:hover { background: #3a424e; }
QFrame#viewportToolRail QToolButton:checked { background: #315d88; border-color: #6c9dca; }
QFrame#viewportToolRail QToolButton:pressed { background: #416d98; }
QFrame#viewportToolRail QToolButton#toolLabelsToggle:checked { background: transparent; border-color: transparent; }
QFrame#viewportToolRail QToolButton#toolLabelsToggle:hover { background: #3a424e; }
QFrame#toolDivider { background: #424c59; border: none; }
QFrame#toolContext { background: #252a31; border: 1px solid #414853; border-radius: 4px; }
QLabel#activeToolLabel { color: #d5dde7; font-size: 11px; padding: 0 3px; }
QFrame#toolContext QComboBox { font-size: 11px; }
QFrame#toolContext QComboBox QAbstractItemView {
    color: #e1e8f1; background: #2b323c; border: 1px solid #4b5867;
    selection-background-color: #315d88; outline: none; padding: 3px;
}
QFrame#toolContext QComboBox QAbstractItemView::item { min-height: 24px; padding: 0 6px; }
QFrame#toolContext QToolButton {
    color: #d5dde7; border: 1px solid #4b5867; border-radius: 3px;
    background: #343c47; padding: 3px 7px; font-size: 11px;
}
QFrame#toolContext QToolButton:hover { background: #445364; }
QFrame#toolContext QToolButton:checked { background: #315d88; border-color: #6c9dca; }
